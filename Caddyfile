# 한미르톡 운영 리버스 프록시 (Caddy 2) — Cloudflare Tunnel 전용.
#
# 외부 HTTPS 는 Cloudflare 가 담당한다. VM 내부에서는 cloudflared(systemd)
# 가 http://127.0.0.1:80 으로 Caddy 에 전달하므로 이 파일은 :80 을 유지한다.
# Caddy 에서 443, Let's Encrypt, tls 인증서 설정을 직접 추가하지 않는다.

:80 {
	encode gzip zstd

	# 업로드 본문 크기 한도 — 서버 UPLOAD_MAX_BYTES(50MB)에 여유를 더해 정렬.
	request_body {
		max_size 60MB
	}

	# API + socket.io(WebSocket) + 파일 다운로드 → server 컨테이너.
	handle /api/* {
		reverse_proxy server:4000
	}
	handle /socket.io/* {
		reverse_proxy server:4000
	}

	# 그 외 전부 → web (Next.js).
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
