# =============================================================================
# 한미르톡 환경 변수 템플릿
# -----------------------------------------------------------------------------
# 이 파일을 `.env` (또는 환경별 .env.local 등) 으로 복사한 뒤 값을 채워 주세요.
# 실제 운영 비밀번호/시크릿은 절대 저장소에 커밋하지 마세요.
# 모든 항목에는 기본값이 있으므로 미설정 시에도 dev 모드는 동작합니다.
# =============================================================================


# -----------------------------------------------------------------------------
# 백엔드 — Express 서버 (`server/`)
# -----------------------------------------------------------------------------

# Express 가 바인딩할 포트 번호
# - 기본: 4000
# - dev 에서는 4000 ~ 4099 사이 아무 포트나 사용 가능
PORT=4000

# 모든 REST 라우트의 공통 prefix
# - 기본: /api/v1
# - 프론트의 `NEXT_PUBLIC_API_BASE_URL` 도 동일한 prefix 를 포함해야 합니다
API_PREFIX=/api/v1

# CORS 로 허용할 출처 (Origin) 목록
# - 기본: http://localhost:3000  (Next dev 서버)
# - 콤마(,) 로 여러 개 지정 가능: "http://localhost:3000,https://hanmir-talk.local"
# - "*" 로 두면 모든 출처 허용 (dev 외에는 절대 비추천)
CORS_ORIGIN=http://localhost:3000

# 개발용 공용 비밀번호 (모든 시드 계정이 사용하는 비밀번호)
# - 기본: hanmir1234
# - bcrypt/argon2 도입 전까지의 임시 값이므로 운영 배포 전 반드시 교체 필요
DEFAULT_PASSWORD=hanmir1234

# PostgreSQL 연결 문자열
# - 설정하면 백엔드가 PostgreSQL 어댑터(`server/src/repositories/postgres.ts`)
#   를 사용합니다. 부팅 로그에 `repository adapter: postgres` 출력 확인.
# - 미설정이면 in-memory seed 어댑터로 동작 (dev 기본값)
# - 로컬 dev 용 docker-compose Postgres 를 쓸 경우 아래 값이 그대로 맞습니다:
#     npm run db:up
# DATABASE_URL=postgres://hanmir:hanmir_dev@localhost:5432/hanmir_talk

# 업로드된 파일의 저장 디렉토리 (로컬 디스크 어댑터)
# - 기본: <repo>/server/uploads
# - 운영 환경에서는 docker volume 마운트 경로로 덮어쓰기를 권장
# - 디렉토리는 서버가 자동으로 생성합니다 (없으면 mkdir -p)
# UPLOAD_DIR=/var/lib/hanmir-talk/uploads

# 업로드 1회당 허용 최대 바이트 수
# - 기본: 26214400 (25 MB)
# - multer 의 fileSize 한계로 사용됩니다 (초과 시 413 응답)
# UPLOAD_MAX_BYTES=26214400

# 실행 환경 표시 (Node 표준)
# - production 일 때 중앙 에러 핸들러가 스택 트레이스를 가립니다
# - dev 일 때는 콘솔에 전체 스택을 찍습니다
# NODE_ENV=production


# -----------------------------------------------------------------------------
# 프론트엔드 — Next.js (`apps/web/`)
# -----------------------------------------------------------------------------

# 프론트가 호출할 API base URL
# - 서버 컴포넌트(SSR) 와 브라우저 모두에서 접근 가능해야 합니다
# - 반드시 `/api/v1` 까지 포함하세요 (서비스 함수들이 상대 경로로 호출)
# - 운영에서는 도메인 + HTTPS 로 교체: https://hanmir-talk.local/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# 위 값의 server-side 폴백 (SSR 전용)
# - 보통은 `NEXT_PUBLIC_API_BASE_URL` 만 설정하면 되고, 따로 둘 필요 없음
# - 내부망에서 SSR 만 다른 호스트로 가도록 분리할 때 사용
# API_BASE_URL=http://hanmir-talk-api.internal/api/v1


# =============================================================================
# 시드 계정 (개발용 — 모두 DEFAULT_PASSWORD 로 로그인)
# -----------------------------------------------------------------------------
# 비밀번호는 모두 위 `DEFAULT_PASSWORD` (기본 hanmir1234) 와 동일합니다.
#
# ┌─────────────┬─────────────────────────────────┬────────────────┬──────────────────────────────────────┐
# │ 이름         │ 이메일                            │ 역할             │ 비고                                   │
# ├─────────────┼─────────────────────────────────┼────────────────┼──────────────────────────────────────┤
# │ 정민호       │ jung.minho@hanmir.co.kr          │ super_admin    │ 최상위 관리자. /admin · 대시보드 전부 가능   │
# │ 강은혜       │ kang.eunhye@hanmir.co.kr         │ admin          │ 회사 관리자. 공지 작성/확인 현황 등        │
# │ 박지영       │ park.jiyoung@hanmir.co.kr        │ project_owner  │ 프로젝트/업무/제품 write 가능              │
# │ 김민준       │ kim.minjun@hanmir.co.kr          │ manager        │ 프로젝트/업무/제품 write 가능              │
# └─────────────┴─────────────────────────────────┴────────────────┴──────────────────────────────────────┘
#
# 일반 사용자 (`member`) 시드는 003 마이그레이션에 포함돼 있지 않습니다.
# 필요하면 admin/super_admin 토큰으로 POST /api/v1/users 를 호출해 직접 생성하세요.
# 예시:
#   curl -X POST http://localhost:4000/api/v1/users \
#     -H "Authorization: Bearer <admin-token>" \
#     -H "Content-Type: application/json" \
#     -d '{
#       "name": "양홍준",
#       "email": "yanghj@hanmir.co.kr",
#       "departmentId": "<부서 id>",
#       "position": "개발자",
#       "role": "member"
#     }'
#
# 권한 매트릭스 요약:
#   super_admin / admin  → /admin, dashboard admin-only API, 공지 작성, 확인 현황 조회
#   manager / project_owner / admin / super_admin (writer 4종)
#                        → 프로젝트 CRUD, 업무 CRUD, 제품 CRUD, 채팅 메시지 작성
#   member               → 읽기 위주 (write 시 403 forbidden)
# =============================================================================
