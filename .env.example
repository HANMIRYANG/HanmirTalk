# ---------------------------------------------------------------------------
# Hanmir Talk — environment template
# Copy this file to `.env` (or platform-specific equivalents) and adjust per
# environment. Do NOT commit real secrets.
# ---------------------------------------------------------------------------

# ------- Backend (server/) -------

# Express listener port (default 4000)
PORT=4000

# Public API prefix (default /api/v1)
API_PREFIX=/api/v1

# Allowed CORS origin(s). Comma-separated for multiple. Use "*" only in dev.
CORS_ORIGIN=http://localhost:3000

# Shared dev password until bcrypt/argon2 hashing is wired in. Every seed
# user authenticates with this value. Rotate or remove before production.
DEFAULT_PASSWORD=hanmir1234

# PostgreSQL connection string. When set, the server uses
# `createPostgresRepositories()` instead of the in-memory adapter (see
# server/src/repositories/postgres.ts). Leave unset to keep the in-memory
# adapter, which is the default for `npm run dev:server` without docker.
#
# To use the bundled docker-compose Postgres (recommended):
#   npm run db:up          # starts container + auto-runs migrations on first boot
#   export DATABASE_URL=postgres://hanmir:hanmir_dev@localhost:5432/hanmir_talk
#   npm run dev:server     # log: "repository adapter: postgres"
#
# DATABASE_URL=postgres://hanmir:hanmir_dev@localhost:5432/hanmir_talk

# ------- Frontend (apps/web/) -------

# Base URL the Next.js app uses to call the backend. Must be reachable from
# both the Next.js server (SSR) and the browser. The "/api/v1" suffix is
# required because services call relative paths under this prefix.
#  # 터미널 1
#  npm run dev:server

#  # 터미널 2
#  npm run dev
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
