# 한미르톡 운영 환경변수 템플릿 — docker-compose.prod.yml 용.
# 이 파일을 .env.prod 로 복사해 실제 값을 채운 뒤:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod 는 git 에 포함하지 말 것 (.gitignore 의 .env* 규칙으로 제외됨).
# 파일 권한을 제한할 것: chmod 600 .env.prod

# ── 접속 주소 ────────────────────────────────────────────────────────
# PUBLIC_ORIGIN : 직원들이 브라우저에 입력하는 주소 (scheme 포함).
#   사내 HTTP 배포 — 서버 VM 의 고정 IP. 서버 CORS·쿠키 정책의 기준이다.
#   http:// 이므로 인증 쿠키에 Secure 플래그가 붙지 않는다 (HTTP 운영에 필수).
#   브라우저용 API 주소는 상대경로(/api/v1)로 고정돼 이 값과 무관하며,
#   HTTPS 전환 시 https:// 로 바꾸면 서버가 자동으로 Secure 쿠키를 쓴다.
PUBLIC_ORIGIN=http://192.168.0.111

# ── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_USER=hanmir
POSTGRES_PASSWORD=__강력한_DB_비밀번호로_교체__
POSTGRES_DB=hanmir_talk

# ── 파일 업로드 ─────────────────────────────────────────────────────
# UPLOAD_DIR_HOST : 호스트(40TB 디스크)의 업로드 보관 경로.
#   배포 전 미리 생성: mkdir -p /srv/hanmir-talk/uploads
UPLOAD_DIR_HOST=/srv/hanmir-talk/uploads
# 업로드 최대 크기(바이트). 기본 50MB.
UPLOAD_MAX_BYTES=52428800

# ── 시드 사용자 초기 비밀번호 ───────────────────────────────────────
# 마이그레이션 003 시드 사용자의 공용 초기 비밀번호. 첫 로그인 시 변경 강제됨.
DEFAULT_PASSWORD=__초기_로그인_비밀번호로_교체__

# ── SMTP — 초대 메일 등 발송 ────────────────────────────────────────
# 사내 메일 서버가 없으면 SMTP_ENABLED=false 로 두면 된다 (초대는 URL 복사로
# 대체 가능 — 메일 실패해도 초대 자체는 유효).
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=한미르톡 <no-reply@hanmir.example>

# ── AI 명령 (Anthropic) ─────────────────────────────────────────────
# 비워두면 /ai 명령이 503 으로 비활성화될 뿐, 앱의 나머지는 정상 동작.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# 사용자별 일일 출력 토큰 상한. 0 = 무제한.
AI_DAILY_TOKEN_LIMIT=0

# ── Web Push (VAPID) ────────────────────────────────────────────────
# 키 생성(1회): npx tsx server/scripts/generate-vapid.ts → 출력값을 아래에.
# 비워두면 웹 푸시만 비활성화되고 인앱 알림은 정상 동작.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hanmir.example
