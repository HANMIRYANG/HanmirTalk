# =============================================================================
# 한미르톡 운영 환경변수 템플릿 (.env.prod)
# -----------------------------------------------------------------------------
# 사용 흐름:
#   1) 이 파일을 .env.prod 로 복사:   cp .env.prod.example .env.prod
#   2) 아래 섹션을 위→아래 순서로 채움 (필수 4개 섹션 + 선택 3개 섹션)
#   3) 파일 권한 제한:                chmod 600 .env.prod
#   4) 기동:
#        docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#   5) 스모크 검증:                   npm run smoke:prod
#
# 주의:
#   - .env.prod 는 절대 git 에 commit 하지 마세요 (.gitignore 의 .env* 규칙
#     으로 제외되지만 한 번 더 확인 권장).
#   - "값을 비워두면" 동작을 각 항목마다 명시했습니다 — 필수 입력만 채우면
#     일단 가동은 됩니다 (선택 기능은 자연스럽게 비활성화).
# =============================================================================


# =============================================================================
# [섹션 1 / 필수] 접속 주소 — 어떤 URL 로 들어오나
# -----------------------------------------------------------------------------
# PUBLIC_ORIGIN
#   - 직원이 브라우저에 입력하는 한미르톡 주소. scheme(http/https) 포함.
#   - Cloudflare Tunnel 운영 표준값:
#       PUBLIC_ORIGIN=https://hanmirworks.space
#   - CORS 와 인증 쿠키 정책의 기준점:
#       * https:// 로 시작하면 → 서버가 쿠키에 Secure 플래그를 자동 부착
#       * http:// 로 시작하면 → Secure 플래그 미부착 (사내 HTTP 배포에 필수)
#   - 브라우저 → API 요청은 상대경로(/api/v1) 라 이 값과 무관하게 동작 →
#     HTTPS 전환 시에도 web 컨테이너 재빌드 불필요.
#
# 운영에서는 아래 값처럼 내부 IP/localhost 를 쓰면 안 됩니다:
#   - PUBLIC_ORIGIN=http://192.168.0.110
#   - PUBLIC_ORIGIN=http://192.168.0.111
#   - PUBLIC_ORIGIN=http://localhost:3000
# 위 값으로 남아 있으면 CORS, Socket.IO origin, Secure cookie 판단이 틀어진다.
# =============================================================================
PUBLIC_ORIGIN=https://hanmirworks.space


# =============================================================================
# [섹션 2 / 필수] PostgreSQL — 데이터 저장소
# -----------------------------------------------------------------------------
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   - postgres 컨테이너의 초기 슈퍼유저·DB 생성에 사용.
#   - server 컨테이너의 DATABASE_URL 도 같은 값으로 자동 구성됨
#     (docker-compose.prod.yml 의 DATABASE_URL 식 참고).
#   - 외부에 포트 노출 안 함 (컴포즈 내부망에서만 도달) — 그래도 비밀번호는
#     강하게 설정. 영문 대소문자+숫자+기호 16자 이상 권장.
#   - 비워두면: 컨테이너가 부팅 자체를 실패 (필수).
# =============================================================================
POSTGRES_USER=hanmir
POSTGRES_PASSWORD=__강력한_DB_비밀번호로_교체__
POSTGRES_DB=hanmir_talk


# =============================================================================
# [섹션 3 / 필수] 파일 업로드 — 호스트 디스크 bind mount
# -----------------------------------------------------------------------------
# UPLOAD_DIR_HOST
#   - VM 호스트의 업로드 보관 경로. 40TB 디스크 풀에서 할당된 위치.
#   - 컨테이너 안에서는 /data/uploads 로 마운트됨 (compose 가 처리).
#   - 배포 전 미리 생성 + 권한:
#       sudo mkdir -p /srv/hanmir-talk/uploads
#       sudo chown -R 1000:1000 /srv/hanmir-talk/uploads   # node user
#   - 비워두면: 컴포즈가 마운트 실패 → server 부팅 실패.
#
# UPLOAD_MAX_BYTES
#   - 업로드 1회당 최대 바이트. spec docs/12 = 50 MB.
#   - Caddyfile 의 request_body max_size(60MB) 와 정합.
#   - 비워두면: 50 MB 기본값.
# =============================================================================
UPLOAD_DIR_HOST=/srv/hanmir-talk/uploads
UPLOAD_MAX_BYTES=52428800


# =============================================================================
# [섹션 4 / 필수] 시드 사용자 초기 비밀번호
# -----------------------------------------------------------------------------
# DEFAULT_PASSWORD
#   - 마이그레이션 003 의 시드 사용자(부서 12 + 직원 22명) 가 첫 로그인에
#     사용할 공용 초기 비밀번호. 첫 로그인 시 변경이 강제됨(마이그 007).
#   - 운영 가동 직후 admin 이 /admin/status 의 "초기 비밀번호 변경" 카드에서
#     미해결 인원을 확인 가능 (#5 카드).
#   - 비워두면: 'hanmir1234' 기본값으로 동작 (운영에는 부적합).
#   - 8자 이상 권장. 너무 단순한 값은 피하되, 직원 안내가 쉬운 값으로.
# =============================================================================
DEFAULT_PASSWORD=__초기_로그인_비밀번호로_교체__


# =============================================================================
# [섹션 5 / 선택] SMTP — 사용자 초대 메일 발송
# -----------------------------------------------------------------------------
# 비워두면: 초대는 여전히 발급 가능하지만 메일 발송 실패. admin 은
#           /admin/invitations 에서 URL 직접 복사로 대체 가능 (초대 자체는 유효).
#
# 사내 메일 서버가 없으면 SMTP_ENABLED=false 로 두는 게 명시적.
# =============================================================================
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false                          # true 면 TLS 직접 연결 (포트 465)
SMTP_FROM=한미르톡 <no-reply@hanmir.example>


# =============================================================================
# [섹션 6 / 선택] AI 명령 — Anthropic Claude (/요약, /업무추출 등 5종)
# -----------------------------------------------------------------------------
# 비워두면: /ai/* 라우트가 503 ai_disabled 반환. 채팅의 / 명령 popover 는
#           떠도 [생성] 클릭 시 안내 메시지("관리자에게 키 설정 요청") 표시.
#           앱의 나머지 기능은 정상 동작.
#
# ANTHROPIC_MODEL: 기본 claude-sonnet-5 (2026-07 운영 결정) — 코딩·에이전트
#   품질이 Sonnet 4.6 대비 크게 개선, 비용 동급.
# AI_DAILY_TOKEN_LIMIT: 사용자별 일일 출력 토큰 상한. 0 = 무제한.
#   사내 평균 사용량 보고 운영 직전 조정 (예: 100000 = 사용자당 일 10만 토큰).
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_DAILY_TOKEN_LIMIT=0


# =============================================================================
# [섹션 6b / 선택] 회의 녹음 → AI 회의록 (Gemini 전사 + Claude 정리)
# -----------------------------------------------------------------------------
# 채팅방 헤더의 [회의 시작] 으로 브라우저 녹음 → 종료 시 Gemini 전사 →
# Claude 회의록 정리 → DOCX 2건(회의록/전사전문)을 방에 자동 게시.
#
# 비워두면: 회의 시작 API 가 503 meeting_ai_disabled 반환 — 버튼 클릭 시
#           "회의록 AI 미설정" 안내. 앱의 나머지 기능은 정상 동작.
#           (회의록 정리는 위 섹션 6 의 ANTHROPIC_API_KEY 를 함께 사용 —
#            둘 다 있어야 회의 시작이 허용된다.)
#
# GEMINI_MODEL: 기본 gemini-3.5-flash (2026-07 운영 결정).
# MEETING_MAX_HOURS: 회의 1건 최대 녹음 시간 (기본 4시간).
# AUDIO_RETENTION_DAYS: 원본 오디오 보존 기간 — 경과 시 매일 KST 04:00
#   정리 잡이 삭제 (기본 30일). 전사/회의록/DOCX 는 계속 보존된다.
# MEETING_AI_MOCK: true 면 Gemini/Claude 호출을 목으로 대체 — API 키 없이
#   파이프라인 동작 검증용 (운영에서는 false).
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
MEETING_MAX_HOURS=4
AUDIO_RETENTION_DAYS=30
MEETING_AI_MOCK=false


# =============================================================================
# [섹션 7 / 선택] Web Push — PWA OS 알림 (VAPID)
# -----------------------------------------------------------------------------
# 비워두면: 인앱 알림(종 아이콘) 은 정상 동작, OS push 만 비활성.
#
# HTTPS 또는 localhost 에서만 동작 — 사내 HTTP 평문 배포에서는 어차피
# 브라우저가 거부하므로 비워둬도 무방. HTTPS 전환 후 활성화 권장.
#
# 키 생성 (1회):
#   npx tsx server/scripts/generate-vapid.ts
# 출력된 PUBLIC/PRIVATE 두 값을 아래에 채우고 SUBJECT 는 운영 담당자 메일.
# =============================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hanmir.example


# =============================================================================
# [섹션 8 / 선택] HanmirERP SSO — 한미르톡을 사내 통합 로그인 진입점으로
# -----------------------------------------------------------------------------
# 비워두면: /api/v1/auth/sso/* 가 503 sso_not_configured — 기존 로그인·
#           다른 기능은 전혀 영향 없음.
#
# 계약 문서: docs/HANMIR_ERP_SSO_CONTRACT.md (등록·교환 흐름·rotation 절차)
#
# SSO_CLIENTS: 등록 클라이언트 JSON 배열 (한 줄). 필드:
#   clientId            영숫자/._- (예: hanmir-erp)
#   name                표시용 이름
#   secretSha256        client secret 의 sha256 hex (64자) — 원문 아님!
#                       원문 secret 은 ERP 서버의 env/vault 에만 저장한다.
#   previousSecretSha256(선택) rotation 유예 기간 동안만 병행 인정
#   redirectUris        사전 등록 콜백 URL 배열 — "정확히 일치" 만 허용
#                       (부분 문자열·와일드카드·다른 포트 전부 거부)
#
# 생성 (1회, secret 원문 + 해시 + JSON 조각 출력):
#   npx tsx server/scripts/generate-sso-client.ts hanmir-erp https://<ERP-호스트>/auth/sso/callback
#
# SSO_TICKET_TTL_SEC: 1회용 authorization ticket 수명(초). 기본 60,
#   서버에서 10~300 으로 강제 clamp.
# =============================================================================
# SSO_CLIENTS=[{"clientId":"hanmir-erp","name":"HanmirERP","secretSha256":"<64-hex>","redirectUris":["https://<ERP-호스트>/auth/sso/callback"]}]
# SSO_TICKET_TTL_SEC=60
#
# SSO authorize/exchange 레이트리밋 (IP 당 분당 횟수, 기본 30) — 부하시험
# 등 특수 상황 외에는 건드릴 필요 없음.
# SSO_AUTHORIZE_RATE_PER_MIN=30
# SSO_EXCHANGE_RATE_PER_MIN=30
#
# 프록시 신뢰 홉 수 — 운영은 compose 기본값 1 (Caddy 한 홉). Caddy 가
# X-Forwarded-For 를 CF-Connecting-IP 유래 단일 IP 로 고정해 보내므로
# 1 초과로 올리면 안 된다. Caddy 없이 직접 노출하는 배포라면 0.
# TRUST_PROXY_HOPS=1


# =============================================================================
# 체크리스트 — 운영 가동 직전 확인
# -----------------------------------------------------------------------------
# [ ] 섹션 1 PUBLIC_ORIGIN — 실 배포 주소로 교체
# [ ] 섹션 2 POSTGRES_PASSWORD — 강한 비밀번호로 교체
# [ ] 섹션 3 UPLOAD_DIR_HOST — 호스트에 디렉터리 미리 생성 + 권한
# [ ] 섹션 4 DEFAULT_PASSWORD — 직원 안내용 초기 비밀번호로 교체
# [ ] (선택) 섹션 5/6/7 키 채우기 — 비워두면 해당 기능만 비활성
# [ ] chmod 600 .env.prod
# [ ] git check-ignore .env.prod        # 출력에 .env.prod 가 보이면 정상.
#                                       #   비어 있으면 .gitignore 점검 — 커밋
#                                       #   사고 방지의 가장 직접적인 확인.
# [ ] docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# [ ] npm run smoke:prod -- \
#       --base-url=http://<운영-VM-IP> \
#       --email=<시드-관리자-이메일> \
#       --password=<시드-비밀번호 또는 변경 후 값>
#     # 또는 환경변수: SMOKE_BASE_URL / SMOKE_EMAIL / SMOKE_PASSWORD
#     # 기대: "결과: 8 PASS / 0 FAIL"
# =============================================================================
